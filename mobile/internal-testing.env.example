# Configure these client-safe values in the EXISTING EAS project's preview environment.
# They must all refer to the same NEW isolated Supabase branch and test API.
EXPO_PUBLIC_EAS_PROJECT_ID=4f31560d-6323-41f7-ae0a-f792a4814c98
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_ISOLATED_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_BRANCH_KEY
EXPO_PUBLIC_API_URL=https://habit-tracker-pr33-internal.onrender.com
INTERNAL_TESTING_SUPABASE_REF=REPLACE_WITH_ISOLATED_REF
INTERNAL_TESTING_API_ORIGIN=https://habit-tracker-pr33-internal.onrender.com
INTERNAL_TESTING_FIREBASE_PROJECT_ID=REPLACE_WITH_EXISTING_FIREBASE_PROJECT_ID
EXPO_PUBLIC_ENABLE_DIAGNOSTICS=false
